  "item": [
    {
      "name": "1. Create Simple Workflow",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"simple-deployment\",\n  \"tasks\": [\n    {\n      \"id\": \"build\",\n      \"type\": \"script\",\n      \"config\": {\n        \"command\": \"echo Building application\"\n      }\n    },\n    {\n      \"id\": \"test\",\n      \"type\": \"script\",\n      \"dependsOn\": [\n        \"build\"\n      ],\n      \"config\": {\n        \"command\": \"echo Running tests\"\n      }\n    },\n    {\n      \"id\": \"deploy\",\n      \"type\": \"notification\",\n      \"dependsOn\": [\n        \"test\"\n      ],\n      \"config\": {\n        \"message\": \"Deployment completed\"\n      }\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:9090/api/workflows",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "9090",
          "path": [
            "api",
            "workflows"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Parallel DAG Workflow",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"parallel-release\",\n    \"tasks\": [\n        {\n            \"id\": \"build\",\n            \"type\": \"script\",\n            \"config\": {\n                \"command\": \"echo Build\"\n            }\n        },\n        {\n            \"id\": \"unit-test\",\n            \"type\": \"script\",\n            \"dependsOn\": [\n                \"build\"\n            ],\n            \"config\": {\n                \"command\": \"echo Unit Test\"\n            }\n        },\n        {\n            \"id\": \"security-test\",\n            \"type\": \"script\",\n            \"dependsOn\": [\n                \"build\"\n            ],\n            \"config\": {\n                \"command\": \"echo Security Test\"\n            }\n        },\n        {\n            \"id\": \"deploy\",\n            \"type\": \"notification\",\n            \"dependsOn\": [\n                \"unit-test\",\n                \"security-test\"\n            ],\n            \"config\": {\n                \"message\": \"Deploy completed\"\n            }\n        }\n    ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:9090/api/workflows",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "9090",
          "path": [
            "api",
            "workflows"
          ]
        }
