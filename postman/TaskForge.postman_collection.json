          "raw": "{\n\"name\":\"approval-release\",\n\n\"tasks\":[\n\n{\n\"id\":\"build\",\n\"type\":\"script\",\n\"config\":{\n\"command\":\"echo build\"\n}\n},\n\n{\n\"id\":\"approval\",\n\"type\":\"approval\",\n\"dependsOn\":[\"build\"]\n},\n\n{\n\"id\":\"production\",\n\"type\":\"notification\",\n\"dependsOn\":[\"approval\"],\n\"config\":{\n\"message\":\"production deployed\"\n}\n}\n\n]\n}",
          "options": {
